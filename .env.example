# Public API and CORS
ALLOWED_ORIGINS=https://ali-ltyt.onrender.com,http://localhost:5173,http://localhost:4173,capacitor://localhost,http://localhost

# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# Firebase Admin SDK (use either the JSON variable or the three fields below)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=ali-enterprises-21c89
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-side application roles. Comma-separated emails are granted admin role at registration.
ADMIN_EMAILS=admin@example.com

# Server-side receipt integrations. Never expose these as VITE_ variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PHOTO_BOT_TOKEN=
PHOTO_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Optional frontend API origin. Leave empty for same-origin web or the default Render API in APK.
VITE_API_ORIGIN=
